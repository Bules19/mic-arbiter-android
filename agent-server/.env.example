# Required. Keep these values on the server; never put the OpenAI API key in the Android app.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Required request authentication. Generate a long random value and configure your client to send it as a Bearer token.
AGENT_ACCESS_TOKEN=replace_with_a_long_random_secret

# Optional configuration
PORT=3000
OPENAI_MODEL=gpt-4.1-mini
